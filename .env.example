# ═══════════════════════════════════════
# Database
# ═══════════════════════════════════════
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studio_booking?schema=public"

# ═══════════════════════════════════════
# Redis (кэш, очереди BullMQ, сессии бота)
# ═══════════════════════════════════════
REDIS_URL="redis://localhost:6379"

# ═══════════════════════════════════════
# Telegram Bot
# ═══════════════════════════════════════
BOT_TOKEN="your-telegram-bot-token"
BOT_USERNAME="studio_bot"
TELEGRAM_ADMIN_CHAT_IDS="123456,789012"  # ID чатов для уведомлений админам

# ═══════════════════════════════════════
# URLs
# ═══════════════════════════════════════
ADMIN_URL="http://localhost:3000"
API_URL="http://localhost:4000"
MINI_APP_URL="http://localhost:5174"

# ═══════════════════════════════════════
# JWT Auth
# ═══════════════════════════════════════
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="your-jwt-refresh-secret"

# ═══════════════════════════════════════
# Studio
# ═══════════════════════════════════════
STUDIO_NAME="Фотостудия XYZ"
STUDIO_ADDRESS="г. Москва, ул. Примерная, 1"

# ═══════════════════════════════════════
# Timezone
# ═══════════════════════════════════════
TZ="Europe/Moscow"
NODE_ENV="development"

# ═══════════════════════════════════════
# Marketing
# ═══════════════════════════════════════
QUIET_HOURS_START="21:00"
QUIET_HOURS_END="10:00"
CAMPAIGN_THROTTLE_MSG_PER_SEC=30
CAMPAIGN_COOLDOWN_DAYS=3
