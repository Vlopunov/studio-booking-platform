generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════
// ПЛОЩАДКИ И РАСПИСАНИЕ
// ═══════════════════════════════════════

model Venue {
  id            String      @id @default(uuid())
  name          String
  slug          String      @unique
  type          VenueType
  description   String?
  address       String?
  photos        String[]    @default([])
  pricePerHour  Decimal     @db.Decimal(10, 2)
  minHours      Int         @default(1)
  maxHours      Int         @default(12)
  capacity      Int?
  amenities     String[]    @default([])
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  schedules     Schedule[]
  bookings      Booking[]
  pricingRules  PricingRule[]
  blockedSlots  BlockedSlot[]
  addons        Addon[]
  preferredBy   Client[]    @relation("PreferredVenue")

  @@index([isActive])
}

enum VenueType {
  PHOTO_STUDIO
  EVENT_HALL
}

model Schedule {
  id        String  @id @default(uuid())
  venueId   String
  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  dayOfWeek Int     // 0=Пн ... 6=Вс
  openTime  String  // "09:00"
  closeTime String  // "22:00"
  isActive  Boolean @default(true)

  @@unique([venueId, dayOfWeek])
}

model BlockedSlot {
  id        String   @id @default(uuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  dateFrom  DateTime
  dateTo    DateTime
  reason    String?
  createdAt DateTime @default(now())
}

// ���══════════════════════════════════════
// ДОПУСЛУГИ
// ═══════════════════════════════════════

model Addon {
  id          String         @id @default(uuid())
  venueId     String?
  venue       Venue?         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal        @db.Decimal(10, 2)
  priceType   AddonPriceType @default(FLAT)
  maxQuantity Int            @default(1)
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)

  bookingAddons BookingAddon[]
}

enum AddonPriceType {
  FLAT
  PER_HOUR
}

// ═══════════════════════════════════════
// ДИНАМИЧЕСКОЕ ЦЕНООБРАЗОВАНИЕ
// ═══════════════════════════════════════

model PricingRule {
  id           String          @id @default(uuid())
  venueId      String
  venue        Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name         String
  type         PricingRuleType
  multiplier   Decimal         @db.Decimal(4, 2)
  dayOfWeek    Int?
  startTime    String?
  endTime      String?
  specificDate DateTime?
  minHours     Int?
  priority     Int             @default(0)
  isActive     Boolean         @default(true)
}

enum PricingRuleType {
  WEEKEND
  TIME_RANGE
  SPECIFIC_DATE
  LONG_BOOKING
}

// ���══════════════════════════════════════
// КЛИЕНТЫ
// ════════��══════════════════════════════

model Client {
  id                String      @id @default(uuid())
  telegramId        BigInt      @unique
  telegramUsername  String?
  firstName         String
  lastName          String?
  phone             String?     @unique
  email             String?
  birthday          DateTime?   @db.Date
  notes             String?
  tags              String[]    @default([])
  source            String?
  language          String      @default("ru")

  // Лояльность
  loyaltyTier       LoyaltyTier @default(BRONZE)
  bonusBalance      Int         @default(0)
  totalSpent        Decimal     @default(0) @db.Decimal(12, 2)
  totalBookings     Int         @default(0)
  referralCode      String      @unique
  referredById      String?
  referredBy        Client?     @relation("Referrals", fields: [referredById], references: [id])
  referrals         Client[]    @relation("Referrals")

  // Предпочтения
  preferredVenueId  String?
  preferredVenue    Venue?      @relation("PreferredVenue", fields: [preferredVenueId], references: [id])
  preferredTimeSlot String?

  // RFM-сегментация
  rfmSegment        RfmSegment?
  rfmRecency        Int?
  rfmFrequency      Int?
  rfmMonetary       Decimal?    @db.Decimal(12, 2)

  // Маркетинг
  marketingOptOut   Boolean     @default(false)
  lastMarketingAt   DateTime?
  lastActivityAt    DateTime    @default(now())

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  bookings            Booking[]
  bonusHistory        BonusTransaction[]
  usedPromocodes      UsedPromocode[]
  waitlistEntries     WaitlistEntry[]
  reviews             Review[]
  utmSources          UtmSource[]
  campaignDeliveries  CampaignDelivery[]
  purchasedGifts      GiftCertificate[] @relation("GiftPurchaser")
  redeemedGifts       GiftCertificate[] @relation("GiftRedeemer")
  autoMessageLogs     AutoMessageLog[]

  @@index([telegramId])
  @@index([loyaltyTier])
  @@index([rfmSegment])
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum RfmSegment {
  CHAMPIONS
  LOYAL
  PROMISING
  NEW
  SLEEPING
  LOST
}

// ═══════════════════════════════════════
// БРОНИРОВАНИЯ
// ══════════════════���════════════════════

model Booking {
  id              String        @id @default(uuid())
  humanId         String        @unique // "B-240405-001"
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  venueId         String
  venue           Venue         @relation(fields: [venueId], references: [id])

  date            DateTime      @db.Date
  startTime       String
  endTime         String
  durationHours   Int

  // Ценообразование
  basePrice       Decimal       @db.Decimal(10, 2)
  pricingDetails  Json?
  addonsTotal     Decimal       @db.Decimal(10, 2) @default(0)
  discountAmount  Decimal       @db.Decimal(10, 2) @default(0)
  discountDetails Json?
  bonusUsed       Int           @default(0)
  bonusEarned     Int           @default(0)
  finalPrice      Decimal       @db.Decimal(10, 2)
  promocodeId     String?

  status          BookingStatus @default(PENDING)
  comment         String?
  adminNote       String?
  cancelReason    String?
  cancelledBy     String?

  // Напоминания
  reminder24hSent Boolean       @default(false)
  reminder2hSent  Boolean       @default(false)
  followUpSent    Boolean       @default(false)

  // Повторная бронь
  rebooked        Boolean       @default(false)
  sourceBookingId String?

  // Маркетинг
  campaignId      String?
  utmSource       String?
  giftCertId      String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  confirmedAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?

  addons          BookingAddon[]
  review          Review?

  @@index([venueId, date])
  @@index([clientId])
  @@index([status, date])
  @@index([campaignId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model BookingAddon {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addonId   String
  addon     Addon   @relation(fields: [addonId], references: [id])
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(10, 2)
}

// ═══════════════════════════════════════
// ЛИСТ ОЖИДАНИЯ
// ════════════��══════════════════════════

model WaitlistEntry {
  id           String   @id @default(uuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])
  venueId      String
  desiredDate  DateTime @db.Date
  desiredStart String?
  desiredEnd   String?
  isNotified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  notifiedAt   DateTime?

  @@index([venueId, desiredDate])
}

// ═══════════════════════════════════════
// ОТЗЫВЫ
// ═════════════════════════════��═════════

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  rating    Int
  comment   String?
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([rating])
}

// ═══���═══════════════════════════════════
// БОНУСЫ И ПРОМОК��ДЫ
// ════════════���══════════════════════════

model BonusTransaction {
  id          String    @id @default(uuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  amount      Int
  type        BonusType
  description String
  bookingId   String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([clientId])
}

enum BonusType {
  EARNED
  SPENT
  REFERRAL
  PROMO
  ADMIN_ADJUST
  BIRTHDAY
  TIER_UPGRADE
  WIN_BACK
  REVIEW
  MILESTONE_BONUS
  FIRST_BOOKING
  EXPIRED
}

model Promocode {
  id              String      @id @default(uuid())
  code            String      @unique
  type            PromoType
  value           Decimal     @db.Decimal(10, 2)
  minOrderAmount  Decimal?    @db.Decimal(10, 2)
  maxDiscount     Decimal?    @db.Decimal(10, 2)
  maxUses         Int?
  usedCount       Int         @default(0)
  validFrom       DateTime
  validUntil      DateTime
  isActive        Boolean     @default(true)
  venueId         String?
  tierRestriction LoyaltyTier?
  firstBookingOnly Boolean    @default(false)
  createdAt       DateTime    @default(now())

  campaigns       Campaign[]
}

enum PromoType {
  PERCENT
  FIXED
  BONUS_POINTS
}

model UsedPromocode {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  promocodeId String
  bookingId   String?
  usedAt      DateTime @default(now())

  @@unique([clientId, promocodeId])
}

// ═══════════════════════════════════════
// МАРКЕТИНГОВЫЕ КАМПАНИИ
// ═════════════════════��═════════════════

model Campaign {
  id              String           @id @default(uuid())
  name            String
  type            CampaignType
  status          CampaignStatus   @default(DRAFT)

  messageText     String
  messagePhoto    String?
  buttonText      String?
  buttonAction    String?

  targeting       Json?
  promocodeId     String?
  promocode       Promocode?       @relation(fields: [promocodeId], references: [id])

  scheduledAt     DateTime?
  sentAt          DateTime?
  completedAt     DateTime?

  totalTargeted   Int              @default(0)
  totalSent       Int              @default(0)
  totalRead       Int              @default(0)
  totalClicked    Int              @default(0)
  totalConverted  Int              @default(0)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  deliveries      CampaignDelivery[]

  @@index([status])
}

enum CampaignType {
  BROADCAST
  AUTOMATED
  SCHEDULED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  CANCELLED
}

model CampaignDelivery {
  id          String         @id @default(uuid())
  campaignId  String
  campaign    Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id])
  status      DeliveryStatus @default(PENDING)
  sentAt      DateTime?
  clickedAt   DateTime?
  convertedAt DateTime?

  @@unique([campaignId, clientId])
  @@index([clientId])
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  CLICKED
  CONVERTED
}

// ═══════════════════════════════════════
// ПОДАРОЧНЫЕ СЕРТИФИКАТЫ
// ════════════════════════════════════��══

model GiftCertificate {
  id            String    @id @default(uuid())
  code          String    @unique
  type          GiftType
  value         Decimal   @db.Decimal(10, 2)
  venueId       String?

  purchasedById String?
  purchasedBy   Client?   @relation("GiftPurchaser", fields: [purchasedById], references: [id])
  recipientName String?
  message       String?

  redeemedById  String?
  redeemedBy    Client?   @relation("GiftRedeemer", fields: [redeemedById], references: [id])
  redeemedAt    DateTime?
  bookingId     String?

  expiresAt     DateTime
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@index([code])
}

enum GiftType {
  AMOUNT
  HOURS
}

// ═══════════════════════════════════════
// UTM-ТРЕКИНГ
// ════════════════���══════════════════════

model UtmSource {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  source     String
  medium     String?
  campaign   String?
  content    String?
  term       String?
  landingUrl String?
  createdAt  DateTime @default(now())

  @@index([source, medium])
  @@index([clientId])
}

// ═══════════════════════════════════════
// АВТОМАТИЧЕСКИЕ ТРИГГЕРНЫЕ СООБЩЕНИЯ
// ═══════��═══════════════════════════════

model AutoMessage {
  id                String       @id @default(uuid())
  name              String
  trigger           AutoTrigger
  delayMinutes      Int          @default(0)
  messageText       String
  messagePhoto      String?
  buttonText        String?
  buttonAction      String?
  isActive          Boolean      @default(true)

  maxSendsPerClient Int          @default(1)
  cooldownDays      Int          @default(30)
  tierRestriction   LoyaltyTier?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  logs              AutoMessageLog[]
}

enum AutoTrigger {
  BOOKING_ABANDONED
  FIRST_BOOKING_COMPLETED
  NO_BOOKING_7_DAYS
  INACTIVE_30_DAYS
  INACTIVE_60_DAYS
  INACTIVE_90_DAYS
  BIRTHDAY_3_DAYS_BEFORE
  TIER_UPGRADE
  BONUS_EXPIRY_7_DAYS
  REVIEW_POSITIVE
  BOOKING_MILESTONE
}

model AutoMessageLog {
  id             String      @id @default(uuid())
  autoMessageId  String
  autoMessage    AutoMessage @relation(fields: [autoMessageId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id])
  sentAt         DateTime    @default(now())
  clickedAt      DateTime?
  convertedAt    DateTime?

  @@index([autoMessageId, clientId])
  @@index([clientId, sentAt])
}

// ═══════════════════════════════════════
// НАСТРОЙКИ ЛОЯЛЬНОСТИ
// ══════════��════════════════════════════

model LoyaltySettings {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

// ═══════════════���═══════════════════════
// АНАЛИТИЧЕСКИЕ СОБЫТИЯ
// ══════════════════════���════════════════

model AnalyticsEvent {
  id        String   @id @default(uuid())
  type      String
  clientId  String?
  venueId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([clientId])
}

// ═══════════════════════════════════════
// АДМИНИСТРАТОРЫ И АУДИТ
// ═══════════════════════════════════════

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(MANAGER)
  telegramId   BigInt?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs    AuditLog[]
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([adminId])
  @@index([createdAt])
}
